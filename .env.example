# Public application base URL
VITE_APP_URL=http://localhost:5173

# ─── Supabase (Auth + Database) — مجاني بدون كارت بنكي ──────────────────────
# من: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Microsoft Entra ID (اختياري — يُفعَّل بعد الحصول على Azure من مدير الوزارة) ───
# من: portal.azure.com → App Registrations
# يُضاف في: Supabase Dashboard → Authentication → Providers → Azure
