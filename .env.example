# Google Gemini API Key (100% Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Fish Audio API Key & Voice Model (from https://fish.audio/)
FISH_AUDIO_API_KEY=
# Optional: Choose any voice ID from https://fish.audio/discovery (Leave blank for default)
FISH_AUDIO_VOICE_ID=

# Official OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=

# Public application base URL
VITE_APP_URL=http://localhost:5173
