# ─────────────────────────────────────────────────────────────────────────────
# SciNexa environment
# VITE_* values are compiled into the browser bundle. Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk — authentication (test publishable key is safe for the browser)
# Dashboard: https://dashboard.clerk.com → API keys
VITE_CLERK_PUBLISHABLE_KEY=

# Public application URL
VITE_APP_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Live Production Database & Real-Time Sync (ISEF 2026)
# Add these in Vercel Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
