# Google Gemini API Key (100% Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Fish Audio API Key & Voice Model (from https://fish.audio/)
FISH_AUDIO_API_KEY=
# Optional: Choose any voice ID from https://fish.audio/discovery (Leave blank for default)
FISH_AUDIO_VOICE_ID=

# Official OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=

# Public application base URL
VITE_APP_URL=http://localhost:5173

# ─── Microsoft Entra ID (Azure AD) ───────────────────────────────────────────
# Register your app at https://portal.azure.com → Azure Active Directory → App Registrations
# Redirect URI: https://scinexa.vercel.app/api/auth/callback (and http://localhost:5173/api/auth/callback for dev)

# Your app's Client ID (Application ID)
AZURE_CLIENT_ID=

# Your Azure AD Tenant ID (Directory ID) — use "common" for multi-tenant
AZURE_TENANT_ID=

# Your app's Client Secret (from Certificates & Secrets)
AZURE_CLIENT_SECRET=

# ─── Session Security ─────────────────────────────────────────────────────────
# 64-character random hex string for AES-256-GCM session encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
